+
+TEST(DecodeDCTest, ByteCountNeedsTheHeaders) {
+  std::vector<uint8_t> data = EncodePixels(LargeVarDCT());
+  uint64_t count = 0;
+  EXPECT_EQ(JXL_DEC_NEED_MORE_INPUT,
+            JxlDecoderGetDCByteCount(data.data(), 100, &count));
+  // Cut inside the frame header / TOC: the frame starts after the image
+  // headers, which a 2600x2200 sRGB image keeps under 40 bytes.
+  EXPECT_EQ(JXL_DEC_NEED_MORE_INPUT,
+            JxlDecoderGetDCByteCount(data.data(), 40, &count));
+}
