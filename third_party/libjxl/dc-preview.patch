+struct Decoded {
+  JxlDecoderStatus dc_status = JXL_DEC_ERROR;
+  bool got_progression = false;
+  bool full_done = false;
+  size_t xsize = 0, ysize = 0;
+  std::vector<uint8_t> dc;    // RGBA8, ceil(x/8) x ceil(y/8)
+  std::vector<uint8_t> full;  // RGBA8
+};
+
+// Decodes to the full image, asking for the DC image at the first DC event
+// (or, without one, when the output buffer is set) with a buffer of
+// dc_size_delta bytes more than needed and in data type `type`.
+Decoded Decode(const std::vector<uint8_t>& data, int dc_size_delta = 0,
+               JxlDataType type = JXL_TYPE_UINT8) {
+  Decoded d;
+  JxlDecoderPtr dec = JxlDecoderMake(nullptr);
+  EXPECT_EQ(JXL_DEC_SUCCESS,
+            JxlDecoderSubscribeEvents(dec.get(), JXL_DEC_BASIC_INFO |
+                                                     JXL_DEC_FRAME_PROGRESSION |
+                                                     JXL_DEC_FULL_IMAGE));
+  EXPECT_EQ(JXL_DEC_SUCCESS, JxlDecoderSetProgressiveDetail(dec.get(), kDC));
+  EXPECT_EQ(JXL_DEC_SUCCESS, JxlDecoderSetKeepOrientation(dec.get(), JXL_TRUE));
+  EXPECT_EQ(JXL_DEC_SUCCESS,
+            JxlDecoderSetInput(dec.get(), data.data(), data.size()));
+  JxlDecoderCloseInput(dec.get());
+  JxlPixelFormat format = {4, JXL_TYPE_UINT8, JXL_NATIVE_ENDIAN, 0};
+  bool asked = false;
+  auto ask = [&]() {
+    if (asked) return;
+    asked = true;
+    size_t dx = (d.xsize + 7) / 8, dy = (d.ysize + 7) / 8;
+    size_t bytes = (type == JXL_TYPE_FLOAT ? 4 : 1) * 4 * dx * dy;
+    d.dc.assign(bytes + dc_size_delta, 0);
+    JxlPixelFormat f = format;
+    f.data_type = type;
+    d.dc_status = JxlDecoderGetDCImage(dec.get(), &f, d.dc.data(), d.dc.size());
+  };
+  for (;;) {
+    JxlDecoderStatus st = JxlDecoderProcessInput(dec.get());
+    if (st == JXL_DEC_BASIC_INFO) {
+      JxlBasicInfo info;
+      EXPECT_EQ(JXL_DEC_SUCCESS, JxlDecoderGetBasicInfo(dec.get(), &info));
+      d.xsize = info.xsize;
+      d.ysize = info.ysize;
+    } else if (st == JXL_DEC_NEED_IMAGE_OUT_BUFFER) {
+      size_t size;
+      EXPECT_EQ(JXL_DEC_SUCCESS,
+                JxlDecoderImageOutBufferSize(dec.get(), &format, &size));
+      d.full.assign(size, 0);
+      EXPECT_EQ(JXL_DEC_SUCCESS, JxlDecoderSetImageOutBuffer(
+                                     dec.get(), &format, d.full.data(), size));
+    } else if (st == JXL_DEC_FRAME_PROGRESSION) {
+      d.got_progression = true;
+      ask();
+    } else if (st == JXL_DEC_FULL_IMAGE) {
+      ask();
+      d.full_done = true;
+      // Only the first frame matters here.
+      break;
+    } else {
+      ADD_FAILURE() << "status " << st;
+      break;
+    }
+  }
+  return d;
+}
