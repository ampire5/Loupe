+TEST(DecodeDCTest, ByteCountRefusesGarbage) {
+  std::vector<uint8_t> junk(4096);
+  for (size_t i = 0; i < junk.size(); i++) junk[i] = (i * 7919 + 13) & 0xFF;
+  uint64_t count = 0;
+  EXPECT_EQ(JXL_DEC_ERROR,
+            JxlDecoderGetDCByteCount(junk.data(), junk.size(), &count));
+}
