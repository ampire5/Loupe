+// Whether exactly `n` leading bytes of data give the DC event and image.
+bool DCReadyWith(const std::vector<uint8_t>& data, size_t n) {
+  JxlDecoderPtr dec = JxlDecoderMake(nullptr);
+  JxlDecoderSubscribeEvents(dec.get(), JXL_DEC_BASIC_INFO |
+                                           JXL_DEC_FRAME_PROGRESSION |
+                                           JXL_DEC_FULL_IMAGE);
+  JxlDecoderSetProgressiveDetail(dec.get(), kDC);
+  JxlDecoderSetInput(dec.get(), data.data(), n);
+  JxlDecoderCloseInput(dec.get());
+  JxlPixelFormat format = {4, JXL_TYPE_UINT8, JXL_NATIVE_ENDIAN, 0};
+  JxlBasicInfo info = {};
+  for (;;) {
+    JxlDecoderStatus st = JxlDecoderProcessInput(dec.get());
+    if (st == JXL_DEC_BASIC_INFO) {
+      JxlDecoderGetBasicInfo(dec.get(), &info);
+    } else if (st == JXL_DEC_NEED_IMAGE_OUT_BUFFER) {
+      JxlDecoderSetImageOutCallback(
+          dec.get(), &format,
+          [](void*, size_t, size_t, size_t, const void*) {}, nullptr);
+    } else if (st == JXL_DEC_FRAME_PROGRESSION) {
+      size_t dx = (info.xsize + 7) / 8, dy = (info.ysize + 7) / 8;
+      std::vector<uint8_t> dc(dx * dy * 4);
+      return JxlDecoderGetDCImage(dec.get(), &format, dc.data(), dc.size()) ==
+             JXL_DEC_SUCCESS;
+    } else {
+      return false;
+    }
+  }
+}
+
+void ExpectExactByteCount(const std::vector<uint8_t>& data) {
+  uint64_t count = 0;
+  ASSERT_EQ(JXL_DEC_SUCCESS,
+            JxlDecoderGetDCByteCount(data.data(), data.size(), &count));
+  EXPECT_LE(count, data.size());
+  EXPECT_TRUE(DCReadyWith(data, count));
+  EXPECT_FALSE(DCReadyWith(data, count - 1));
+  // The prefix alone answers the same.
+  uint64_t again = 0;
+  ASSERT_EQ(JXL_DEC_SUCCESS,
+            JxlDecoderGetDCByteCount(data.data(), count, &again));
+  EXPECT_EQ(count, again);
+}
+
+// Big enough for several DC groups' worth of sections ahead of the AC ones.
+PixelOptions LargeVarDCT() {
+  PixelOptions o;
+  o.xsize = 2600;
+  o.ysize = 2200;
+  return o;
+}
