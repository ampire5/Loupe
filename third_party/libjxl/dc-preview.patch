+struct PixelOptions {
+  size_t xsize = 512;
+  size_t ysize = 384;
+  uint32_t channels = 3;  // 1 gray, 3 RGB, 4 RGBA
+  float distance = 1.0f;
+  int64_t resampling = 1;
+  int frames = 1;
+};
+
+// A smooth picture: the mean of a decoded 8x8 block is then close to its DC.
+std::vector<uint8_t> SmoothPixels(const PixelOptions& o, int frame) {
+  std::vector<uint8_t> px(o.xsize * o.ysize * o.channels);
+  for (size_t y = 0; y < o.ysize; y++) {
+    for (size_t x = 0; x < o.xsize; x++) {
+      for (uint32_t c = 0; c < o.channels; c++) {
+        double v = 128 + 90 * std::sin((x + 3 * c + 7 * frame) / 37.0) *
+                             std::cos((y + 5 * c) / 53.0);
+        if (c == 3) v = 255 - (x * 200) / o.xsize;
+        px[(y * o.xsize + x) * o.channels + c] =
+            static_cast<uint8_t>(std::lround(v));
+      }
+    }
+  }
+  return px;
+}
+
+std::vector<uint8_t> Finish(JxlEncoder* enc) {
+  JxlEncoderCloseInput(enc);
+  std::vector<uint8_t> out(64);
+  uint8_t* next = out.data();
+  size_t avail = out.size();
+  JxlEncoderStatus st;
+  while ((st = JxlEncoderProcessOutput(enc, &next, &avail)) ==
+         JXL_ENC_NEED_MORE_OUTPUT) {
+    size_t used = next - out.data();
+    out.resize(out.size() * 2);
+    next = out.data() + used;
+    avail = out.size() - used;
+  }
+  EXPECT_EQ(JXL_ENC_SUCCESS, st);
+  out.resize(next - out.data());
+  return out;
+}
+
+std::vector<uint8_t> EncodePixels(const PixelOptions& o) {
+  JxlEncoderPtr enc = JxlEncoderMake(nullptr);
+  JxlBasicInfo info;
+  JxlEncoderInitBasicInfo(&info);
+  info.xsize = o.xsize;
+  info.ysize = o.ysize;
+  info.bits_per_sample = 8;
+  info.num_color_channels = o.channels >= 3 ? 3 : 1;
+  info.num_extra_channels = o.channels == 4 ? 1 : 0;
+  info.alpha_bits = o.channels == 4 ? 8 : 0;
+  info.uses_original_profile = o.distance == 0 ? JXL_TRUE : JXL_FALSE;
+  if (o.frames > 1) {
+    info.have_animation = JXL_TRUE;
+    info.animation.tps_numerator = 10;
+    info.animation.tps_denominator = 1;
+  }
+  EXPECT_EQ(JXL_ENC_SUCCESS, JxlEncoderSetBasicInfo(enc.get(), &info));
+  JxlColorEncoding color;
+  JxlColorEncodingSetToSRGB(&color, o.channels < 3 ? JXL_TRUE : JXL_FALSE);
+  EXPECT_EQ(JXL_ENC_SUCCESS, JxlEncoderSetColorEncoding(enc.get(), &color));
+  JxlEncoderFrameSettings* fs = JxlEncoderFrameSettingsCreate(enc.get(), nullptr);
+  if (o.distance == 0) {
+    JxlEncoderSetFrameLossless(fs, JXL_TRUE);
+  } else {
+    JxlEncoderSetFrameDistance(fs, o.distance);
+  }
+  if (o.resampling != 1) {
+    JxlEncoderFrameSettingsSetOption(fs, JXL_ENC_FRAME_SETTING_RESAMPLING,
+                                     o.resampling);
+  }
+  JxlPixelFormat format = {o.channels, JXL_TYPE_UINT8, JXL_NATIVE_ENDIAN, 0};
+  for (int f = 0; f < o.frames; f++) {
+    if (o.frames > 1) {
+      JxlFrameHeader header;
+      JxlEncoderInitFrameHeader(&header);
+      header.duration = 1;
+      JxlEncoderSetFrameHeader(fs, &header);
+    }
+    std::vector<uint8_t> px = SmoothPixels(o, f);
+    EXPECT_EQ(JXL_ENC_SUCCESS,
+              JxlEncoderAddImageFrame(fs, &format, px.data(), px.size()));
+  }
+  return Finish(enc.get());
+}
