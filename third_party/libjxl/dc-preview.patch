+bool FrameDecoder::CanRenderDC(const FrameHeader& header,
+                               const ImageMetadata& metadata) {
+  return header.encoding == FrameEncoding::kVarDCT && header.upsampling == 1 &&
+         metadata.num_extra_channels == 0 && !metadata.have_animation &&
+         header.frame_type == FrameType::kRegularFrame && header.is_last &&
+         header.dc_level == 0 &&
+         header.blending_info.mode == BlendMode::kReplace &&
+         !header.custom_size_or_origin &&
+         (header.flags & (FrameHeader::kPatches | FrameHeader::kSplines)) == 0;
+}
+
+Status FrameDecoder::RenderDC(const JxlPixelFormat& format, void* buffer,
+                              size_t size, bool undo_orientation) {
+  if (!finalized_dc_ || !CanRenderDC(frame_header_, *decoded_->metadata())) {
+    return JXL_FAILURE("No DC image to render");
+  }
+  if (format.data_type != JXL_TYPE_UINT8 || format.num_channels != 4) {
+    return JXL_FAILURE("DC image: only RGBA8");
+  }
+  JxlMemoryManager* memory_manager = dec_state_->memory_manager();
+  // The DC image as a frame of its own: one pixel per block, no padding.
+  // Subsampled chroma DC goes through the frame's chroma upsampling stages, as
+  // the full image does.
+  FrameDimensions dim;
+  dim.Set(DivCeil(frame_dim_.xsize, kBlockDim),
+          DivCeil(frame_dim_.ysize, kBlockDim), frame_header_.group_size_shift,
+          frame_header_.chroma_subsampling.MaxHShift(),
+          frame_header_.chroma_subsampling.MaxVShift(),
+          /*modular_mode=*/true, /*upsampling=*/1);
+
+  PassesDecoderState state(memory_manager);
+  state.shared = dec_state_->shared;
+  state.output_encoding_info = dec_state_->output_encoding_info;
+  state.pipeline_dim = &dim;
+  state.width = dim.xsize;
+  state.height = dim.ysize;
+  state.fast_xyb_srgb8_conversion = false;
+  state.unpremul_alpha = false;
+  state.undo_orientation = Orientation::kIdentity;
+  size_t out_xsize = dim.xsize;
+  size_t out_ysize = dim.ysize;
+  if (undo_orientation) {
+    state.undo_orientation = decoded_->metadata()->GetOrientation();
+    if (static_cast<int>(state.undo_orientation) > 4) {
+      std::swap(out_xsize, out_ysize);
+    }
+  }
+  state.main_output.format = format;
+  state.main_output.bits_per_sample = 8;
+  state.main_output.callback = PixelCallback();
+  state.main_output.buffer = buffer;
+  state.main_output.buffer_size = size;
+  JXL_ASSIGN_OR_RETURN(state.main_output.stride, GetStride(out_xsize, format));
+  if (size < state.main_output.stride * (out_ysize - 1) + out_xsize * 4) {
+    return JXL_FAILURE("DC image: buffer too small");
+  }
+
+  // Colour stages only: no loop filters, noise, patches or splines.
+  FrameHeader header = frame_header_;
+  header.loop_filter.gab = false;
+  header.loop_filter.epf_iters = 0;
+  header.flags = 0;
+  PassesDecoderState::PipelineOptions options;
+  options.use_slow_render_pipeline = false;
+  options.coalescing = false;
+  options.render_spotcolors = false;
+  options.render_noise = false;
+  JXL_RETURN_IF_ERROR(
+      state.PreparePipeline(header, decoded_->metadata(), decoded_, options));
+
+  const Image3F& dc = *dec_state_->shared->dc;
+  const YCbCrChromaSubsampling& cs = frame_header_.chroma_subsampling;
+  const auto prepare = [&](size_t num_threads) -> Status {
+    return state.render_pipeline->PrepareForThreads(num_threads,
+                                                    /*use_group_ids=*/false);
+  };
+  const auto draw = [&](uint32_t group, size_t thread) -> Status {
+    RenderPipelineInput input =
+        state.render_pipeline->GetInputBuffers(group, thread);
+    const size_t gx = group % dim.xsize_groups;
+    const size_t gy = group / dim.xsize_groups;
+    for (size_t c = 0; c < 3; c++) {
+      const std::pair<ImageF*, Rect>& out = input.GetBuffer(c);
+      const size_t x0 = gx * (dim.group_dim >> cs.HShift(c));
+      const size_t y0 = gy * (dim.group_dim >> cs.VShift(c));
+      for (size_t y = 0; y < out.second.ysize(); y++) {
+        memcpy(out.second.Row(out.first, y), dc.PlaneRow(c, y0 + y) + x0,
+               out.second.xsize() * sizeof(float));
+      }
+    }
+    return input.Done();
+  };
+  JXL_RETURN_IF_ERROR(
+      RunOnPool(pool_, 0, dim.num_groups, prepare, draw, "RenderDC"));
+  return true;
+}
