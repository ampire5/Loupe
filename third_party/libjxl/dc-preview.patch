+struct Diff {
+  int max = 0;
+  double p99 = 0;
+  double mean = 0;
+};
+
+enum class Measure { kRGB, kLuma };
+
+double Value(const uint8_t* p, Measure m) {
+  return 0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2];
+}
+
+// Whether a block touches 0 or 255 in the full image: there the full decode's
+// per-pixel clamping moves the block mean away from the DC.
+bool Clamped(const Decoded& d, size_t bx, size_t by) {
+  for (size_t y = by * 8; y < std::min(d.ysize, by * 8 + 8); y++) {
+    for (size_t x = bx * 8; x < std::min(d.xsize, bx * 8 + 8); x++) {
+      for (size_t c = 0; c < 3; c++) {
+        uint8_t v = d.full[(y * d.xsize + x) * 4 + c];
+        if (v == 0 || v == 255) return true;
+      }
+    }
+  }
+  return false;
+}
+
+// The full image averaged over 8x8 blocks against the DC image, per channel
+// (kRGB) or on BT.601 luma (kLuma). Edge blocks the image only partly covers
+// are left out when the file is a JPEG: its DC averages the encoder's padding.
+Diff CompareWithFull(const Decoded& d, Measure m = Measure::kRGB,
+                     bool skip_partial = false, bool skip_clamped = false) {
+  size_t dx = (d.xsize + 7) / 8, dy = (d.ysize + 7) / 8;
+  std::vector<int> diffs;
+  double total = 0;
+  for (size_t by = 0; by < dy; by++) {
+    for (size_t bx = 0; bx < dx; bx++) {
+      if (skip_partial && (bx * 8 + 8 > d.xsize || by * 8 + 8 > d.ysize)) {
+        continue;
+      }
+      if (skip_clamped && Clamped(d, bx, by)) continue;
+      size_t channels = m == Measure::kLuma ? 1 : 3;
+      for (size_t c = 0; c < channels; c++) {
+        double sum = 0;
+        int n = 0;
+        for (size_t y = by * 8; y < std::min(d.ysize, by * 8 + 8); y++) {
+          for (size_t x = bx * 8; x < std::min(d.xsize, bx * 8 + 8); x++) {
+            const uint8_t* p = &d.full[(y * d.xsize + x) * 4];
+            sum += m == Measure::kLuma ? Value(p, m) : p[c];
+            n++;
+          }
+        }
+        const uint8_t* q = &d.dc[(by * dx + bx) * 4];
+        double dc = m == Measure::kLuma ? Value(q, m) : q[c];
+        int diff = static_cast<int>(std::lround(std::fabs(sum / n - dc)));
+        diffs.push_back(diff);
+        total += diff;
+      }
+    }
+  }
+  std::sort(diffs.begin(), diffs.end());
+  Diff r;
+  r.max = diffs.back();
+  r.p99 = diffs[diffs.size() * 99 / 100];
+  r.mean = total / diffs.size();
+  return r;
+}
+
+Decoded DecodeDC(const std::vector<uint8_t>& data) {
+  Decoded d = Decode(data);
+  EXPECT_TRUE(d.got_progression);
+  EXPECT_EQ(JXL_DEC_SUCCESS, d.dc_status);
+  EXPECT_TRUE(d.full_done);
+  return d;
+}
+
+void ExpectDCMatches(const std::vector<uint8_t>& data,
+                     bool skip_partial = false) {
+  Decoded d = DecodeDC(data);
+  if (d.dc_status != JXL_DEC_SUCCESS) return;
+  Diff diff = CompareWithFull(d, Measure::kRGB, skip_partial);
+  EXPECT_LE(diff.max, 2) << "p99 " << diff.p99 << " mean " << diff.mean;
+}
+
+void ExpectRefused(const std::vector<uint8_t>& data) {
+  Decoded d = Decode(data);
+  EXPECT_EQ(JXL_DEC_ERROR, d.dc_status);
+  EXPECT_TRUE(d.full_done);
+}
+
+TEST(DecodeDCTest, LoupeVersion) { EXPECT_EQ(1u, JxlDecoderLoupeVersion()); }
