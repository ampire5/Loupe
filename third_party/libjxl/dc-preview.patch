+JxlDecoderStatus JxlDecoderGetDCByteCount(const uint8_t* data, size_t size,
+                                          uint64_t* count) {
+  if (!data || !count) return JXL_DEC_ERROR;
+  JxlDecoder* dec = JxlDecoderCreate(nullptr);
+  if (!dec) return JXL_DEC_ERROR;
+  JxlDecoderStatus result = JXL_DEC_ERROR;
+  if (JxlDecoderSubscribeEvents(dec, JXL_DEC_FRAME) == JXL_DEC_SUCCESS &&
+      JxlDecoderSetInput(dec, data, size) == JXL_DEC_SUCCESS) {
+    // Input stays open: a short prefix asks for more instead of failing.
+    JxlDecoderStatus st = JxlDecoderProcessInput(dec);
+    if (st == JXL_DEC_NEED_MORE_INPUT) {
+      result = JXL_DEC_NEED_MORE_INPUT;
+    } else if (st == JXL_DEC_FRAME && dec->frame_dec &&
+               jxl::FrameDecoder::CanRenderDC(*dec->frame_header,
+                                              dec->metadata.m)) {
+      // The frame header and TOC are consumed: what is left of the input
+      // starts with the frame's sections.
+      const uint64_t sections = size - JxlDecoderReleaseInput(dec);
+      const auto& toc = dec->frame_dec->Toc();
+      const size_t num_dc_groups =
+          dec->frame_header->ToFrameDimensions().num_dc_groups;
+      uint64_t offset = 0;
+      uint64_t needed = 0;
+      for (const auto& entry : toc) {
+        offset += entry.size;
+        // DC global is section 0, the DC groups 1..num_dc_groups; a frame
+        // with a single section has everything in it.
+        if (toc.size() == 1 || entry.id <= num_dc_groups) needed = offset;
+      }
+      if (InOneBox(data, size, sections, sections + needed)) {
+        *count = sections + needed;
+        result = JXL_DEC_SUCCESS;
+      }
+    }
+  }
+  JxlDecoderDestroy(dec);
+  return result;
+}
