+// Whether file bytes [begin, end) lie inside one box (or a bare codestream),
+// so codestream bytes there map one to one onto file bytes.
+bool InOneBox(const uint8_t* data, size_t size, uint64_t begin, uint64_t end) {
+  static const uint8_t kSignature[] = {0, 0, 0, 0xC, 'J', 'X', 'L', ' '};
+  if (size < sizeof(kSignature) ||
+      memcmp(data, kSignature, sizeof(kSignature)) != 0) {
+    return true;  // bare codestream
+  }
+  uint64_t pos = 0;
+  while (pos + 8 <= size) {
+    uint64_t box = LoadBE32(data + pos);
+    uint64_t header = 8;
+    if (box == 1) {
+      if (pos + 16 > size) return false;
+      box = LoadBE64(data + pos + 8);
+      header = 16;
+    }
+    uint64_t box_end = box == 0 ? UINT64_MAX : pos + box;
+    if (box != 0 && box < header) return false;
+    if (begin < box_end) return begin >= pos + header && end <= box_end;
+    if (box == 0) return false;
+    pos = box_end;
+  }
+  return false;
+}
