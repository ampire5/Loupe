+JXL_TRANSCODE_JPEG_TEST(DecodeDCTest, TranscodedJPEG444) {
+  ExpectDCMatches(TranscodeJPEG("jxl/flower/flower.png.im_q85_444.jpg"),
+                  /*skip_partial=*/true);
+}
+
+// 4:2:0 chroma DC covers 16x16 pixels: only luma is exact at 1:8 (where no
+// pixel is clamped), colour is as close as the file allows (a shifted or
+// misplaced chroma plane is far off).
+JXL_TRANSCODE_JPEG_TEST(DecodeDCTest, TranscodedJPEG420) {
+  Decoded d = DecodeDC(TranscodeJPEG("jxl/flower/flower.png.im_q85_420.jpg"));
+  ASSERT_EQ(JXL_DEC_SUCCESS, d.dc_status);
+  Diff luma = CompareWithFull(d, Measure::kLuma, /*skip_partial=*/true,
+                              /*skip_clamped=*/true);
+  // 3, not 2: luma is taken from 8-bit RGB, rounded three times.
+  EXPECT_LE(luma.max, 3) << "p99 " << luma.p99;
+  Diff rgb = CompareWithFull(d, Measure::kRGB, /*skip_partial=*/true);
+  EXPECT_LE(rgb.mean, 4.5);
+}
